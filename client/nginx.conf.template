# nginx for the Familiar client: the SPA on /, the API (including the conversation event stream) on /api.
#
# A template: the image's entrypoint fills in ${BACKEND_ORIGIN} and ${DNS_RESOLVER} at container
# start. nginx's own $variables are untouched, because envsubst only replaces names that exist in the
# environment.

worker_processes auto;
error_log /var/log/nginx/error.log warn;

# /var/run is root-owned; the container runs as nginx-app.
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    types {
        application/manifest+json webmanifest;
    }

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;

    # Avatar uploads (VRM models) are the largest request bodies.
    client_max_body_size 50M;

    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/manifest+json image/svg+xml;

    # Not an upstream block: nginx resolves an upstream once at startup and refuses to start if it
    # can't, so the client container couldn't boot before the server. A variable defers the lookup
    # to request time, which is what the resolver is for.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    server {
        listen 80 default_server;
        listen [::]:80 default_server;

        # Behind the NAS front proxy, which re-encrypts to here so that $scheme (and so
        # X-Forwarded-Proto) is truthfully https. Certificate: mounted, or self-signed at start.
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        ssl_certificate     /etc/nginx/tls/cert.pem;
        ssl_certificate_key /etc/nginx/tls/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        location = /health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "OK\n";
        }

        location /api/ {
            # With a variable in proxy_pass nginx no longer appends the path, hence $request_uri.
            set $backend "${BACKEND_ORIGIN}";
            proxy_pass $backend$request_uri;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";

            # Unbuffered, so the conversation stream (server-sent events) reaches the browser as it
            # is written. The server pings an idle stream every 15 s, well inside the read timeout.
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Caching is set with `expires` rather than add_header on purpose: any add_header inside a
        # location stops that location inheriting the server-level security headers below.

        # Vite fingerprints asset filenames, so they can be cached for a long time.
        location /assets/ {
            expires 1y;
            try_files $uri =404;
        }

        # Everything else is the SPA. index.html is never cached, so a deploy is picked up.
        location / {
            expires -1;
            try_files $uri $uri/ /index.html;
        }

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Microphone for voice; camera and location stay off until something needs them.
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    }
}
