{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Defaults are in the options classes; these are the keys, so they can be found and overridden
  // (Auth__AllowRegistration=false in compose, and so on).
  "Auth": {
    "CookieName": "familiar.session",
    "SessionDays": 14,
    "RevalidationIntervalSeconds": 60,
    "AllowRegistration": true,
    "LoginFailuresBeforeBackoff": 5,
    "LoginBackoffSeconds": 30,
    "LoginBackoffMaxSeconds": 900,
    "DeviceTokenLifetimeDays": 180,
    "DeviceTokensPerAccount": 10,
    "DeviceTokenTouchMinutes": 60
  },
  "RateLimits": {
    "AuthAttemptsPerMinute": 10,
    "MessagesPerMinute": 30
  },
  // Familiar's own Ollama (PLAN.md §4.2). Point Model at the derived model, never its base: the
  // base answers with a 4096-token window and silently truncates the prompt.
  "Llm": {
    "BaseUrl": "http://localhost:11435",
    "Model": "familiar-chat",
    "Temperature": 0.7,
    "RequestTimeoutSeconds": 120,
    "HistoryMessages": 20
  },
  // Off until configured. Set to the compose network on the NAS (see deploy/docker-compose.nas.yml).
  "Proxy": {
    "KnownNetworks": "",
    "KnownProxies": ""
  },
  "Database": {
    "MigrationRetryBudgetSeconds": 60
  }
}
