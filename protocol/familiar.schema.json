{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Familiar protocol",
  "description": "The conversation stream's events and the request and response bodies the clients share. Generated from the server's records (src/Familiar.Server/Protocol/ProtocolSchema.cs) - don't edit; the TypeScript and Kotlin types are generated from this (client/scripts/protocol.mjs).",
  "x-events": {
    "ready": {
      "constant": "Ready",
      "payload": "ReadyEvent"
    },
    "state": {
      "constant": "State",
      "payload": "StateEvent"
    },
    "message": {
      "constant": "Message",
      "payload": "MessageView"
    },
    "reply.start": {
      "constant": "ReplyStart",
      "payload": "ReplyStartEvent"
    },
    "reply.delta": {
      "constant": "ReplyDelta",
      "payload": "ReplyDeltaEvent"
    },
    "reply.end": {
      "constant": "ReplyEnd",
      "payload": "ReplyEndEvent"
    },
    "reply.truncated": {
      "constant": "ReplyTruncated",
      "payload": "ReplyTruncatedEvent"
    },
    "expression": {
      "constant": "Expression",
      "payload": "ExpressionEvent"
    },
    "gesture": {
      "constant": "Gesture",
      "payload": "GestureEvent"
    },
    "sound": {
      "constant": "Sound",
      "payload": "SoundEvent"
    },
    "audio": {
      "constant": "Audio",
      "payload": "AudioEvent"
    },
    "audio.end": {
      "constant": "AudioEnd",
      "payload": "AudioEndEvent"
    },
    "turn.error": {
      "constant": "Error",
      "payload": "ErrorEvent"
    },
    "tool.started": {
      "constant": "ToolStarted",
      "payload": "ToolStartedEvent"
    },
    "tool.finished": {
      "constant": "ToolFinished",
      "payload": "ToolFinishedEvent"
    },
    "tool.confirm": {
      "constant": "ToolConfirm",
      "payload": "ToolConfirmEvent"
    },
    "tool.confirmed": {
      "constant": "ToolConfirmed",
      "payload": "ToolConfirmedEvent"
    },
    "tool.invoke": {
      "constant": "ToolInvoke",
      "payload": "ToolInvokeEvent"
    },
    "jobs": {
      "constant": "Jobs",
      "payload": "JobsEvent"
    },
    "notify": {
      "constant": "Notify",
      "payload": "NotifyEvent"
    },
    "cleared": {
      "constant": "Cleared",
      "payload": null
    },
    "resync": {
      "constant": "Resync",
      "payload": null
    }
  },
  "$defs": {
    "AccountResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AccountRole"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "role"
      ]
    },
    "AccountRole": {
      "description": "What an account may do on this server.",
      "type": "string",
      "enum": [
        "user",
        "admin"
      ]
    },
    "AddFeedRequest": {
      "type": "object",
      "properties": {
        "name": {
          "description": "What to call it.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Its secret iCal address (https:// or webcal://).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "url"
      ]
    },
    "AdminUserView": {
      "type": "object",
      "properties": {
        "id": {
          "description": "The account.",
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "description": "Its username.",
          "type": "string"
        },
        "email": {
          "description": "Its email.",
          "type": "string"
        },
        "role": {
          "description": "user or admin.",
          "$ref": "#/$defs/AccountRole"
        },
        "createdAt": {
          "description": "When it was made.",
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "description": "When it last signed in, if ever.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "isDisabled": {
          "description": "It can't sign in, and its sessions and devices have stopped working.",
          "type": "boolean"
        },
        "devices": {
          "description": "How many phones it has signed in.",
          "type": "integer"
        },
        "isYou": {
          "description": "The admin looking at the list.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "role",
        "createdAt",
        "lastLoginAt",
        "isDisabled",
        "devices",
        "isYou"
      ]
    },
    "AnnounceRequest": {
      "type": "object",
      "properties": {
        "message": {
          "description": "What to say.",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "description": "\"say\" (word for word, the default) or \"tell\" (the familiar puts it in its own words).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "timeZone": {
          "description": "For \"tell\": the user's IANA time zone, if the caller knows it.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "message"
      ]
    },
    "AppearanceView": {
      "description": "How a familiar looks (PLAN.md §5.5). Either the built-in plush llama, coloured and dressed, or an uploaded VRM model.",
      "type": "object",
      "properties": {
        "model": {
          "description": "A built-in character (llama, fox, hedgehog, monster, otter, giraffe, spot) or \"vrm\".",
          "type": "string",
          "enum": [
            "llama",
            "fox",
            "hedgehog",
            "monster",
            "otter",
            "giraffe",
            "spot",
            "vrm"
          ]
        },
        "vrmId": {
          "description": "For \"vrm\", which uploaded model.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "colours": {
          "description": "The character's colours (what each paints depends on the character).",
          "$ref": "#/$defs/LlamaColours"
        },
        "accessory": {
          "description": "What it wears: none, bow, scarf, glasses, flower. The spot wears nothing.",
          "type": "string",
          "enum": [
            "none",
            "bow",
            "scarf",
            "glasses",
            "flower"
          ]
        },
        "style": {
          "description": "How a built-in character is drawn: \"2d\" (flat, the default) or \"3d\" (modelled and lit).",
          "type": "string",
          "enum": [
            "2d",
            "3d"
          ],
          "default": "2d"
        }
      },
      "required": [
        "model",
        "vrmId",
        "colours",
        "accessory"
      ]
    },
    "AudioEndEvent": {
      "description": "The reply has no more clips coming: Clips were announced in total.",
      "type": "object",
      "properties": {
        "replyId": {
          "type": "string",
          "format": "uuid"
        },
        "clips": {
          "type": "integer"
        }
      },
      "required": [
        "replyId",
        "clips"
      ]
    },
    "AudioEvent": {
      "description": "A spoken sentence is ready to fetch.",
      "type": "object",
      "properties": {
        "replyId": {
          "description": "The reply it belongs to.",
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "description": "Its position in the reply; clips are played in this order.",
          "type": "integer"
        },
        "url": {
          "description": "Where to fetch the audio.",
          "type": "string"
        },
        "text": {
          "description": "What it says.",
          "type": "string"
        },
        "words": {
          "description": "When each word is spoken, if the TTS service says - for mouth shapes.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/SpokenWord"
          },
          "default": null
        }
      },
      "required": [
        "replyId",
        "seq",
        "url",
        "text"
      ]
    },
    "AvatarView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer"
        },
        "meta": {
          "$ref": "#/$defs/VrmInfo"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "sizeBytes",
        "meta",
        "createdAt"
      ]
    },
    "CalendarKind": {
      "type": "string",
      "enum": [
        "local",
        "ics",
        "device"
      ]
    },
    "CalendarView": {
      "description": "A calendar as Settings shows it. Never the feed's address: that's a secret.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/CalendarKind"
        },
        "name": {
          "type": "string"
        },
        "lastSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "lastSyncedAt",
        "lastError"
      ]
    },
    "ChangePasswordRequest": {
      "type": "object",
      "properties": {
        "currentPassword": {
          "type": [
            "string",
            "null"
          ]
        },
        "newPassword": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "currentPassword",
        "newPassword"
      ]
    },
    "ConfirmRequest": {
      "type": "object",
      "properties": {
        "callId": {
          "description": "The tool call being answered, from the tool.confirm event.",
          "type": [
            "string",
            "null"
          ]
        },
        "approve": {
          "description": "Whether the user allows it.",
          "type": "boolean"
        }
      },
      "required": [
        "callId",
        "approve"
      ]
    },
    "CreateUserRequest": {
      "type": "object",
      "properties": {
        "username": {
          "description": "3-24 letters, digits or underscores.",
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "description": "Their email.",
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "description": "A first password, for them to change.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "user (the default) or admin.",
          "anyOf": [
            {
              "$ref": "#/$defs/AccountRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "username",
        "email",
        "password"
      ]
    },
    "DeviceCalendarUpload": {
      "type": "object",
      "properties": {
        "events": {
          "description": "Every event in the window the phone covers (the next couple of weeks).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/DeviceEventView"
          }
        }
      },
      "required": [
        "events"
      ]
    },
    "DeviceEventView": {
      "description": "One event (or occurrence) from a phone's calendar.",
      "type": "object",
      "properties": {
        "externalId": {
          "description": "The phone's id for it (instance id plus start), stable across uploads.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Its title.",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "description": "Where, if it says.",
          "type": [
            "string",
            "null"
          ]
        },
        "startsAt": {
          "description": "When it starts; for an all-day event, UTC midnight of its date.",
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "description": "When it ends.",
          "type": "string",
          "format": "date-time"
        },
        "allDay": {
          "description": "A whole-day event.",
          "type": "boolean"
        },
        "calendar": {
          "description": "Which of the phone's calendars (\"Work\", \"sam@gmail.com\").",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "externalId",
        "title",
        "location",
        "startsAt",
        "endsAt",
        "allDay"
      ]
    },
    "DeviceLoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "username",
        "password",
        "deviceName"
      ]
    },
    "DeviceLoginResponse": {
      "description": "Returned once, at sign-in. The token is never retrievable again.",
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "device": {
          "$ref": "#/$defs/DeviceSummary"
        },
        "account": {
          "$ref": "#/$defs/AccountResponse"
        }
      },
      "required": [
        "token",
        "device",
        "account"
      ]
    },
    "DeviceSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUsedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "isCurrent": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "expiresAt",
        "lastUsedAt",
        "isCurrent"
      ]
    },
    "Emotion": {
      "description": "What the familiar is feeling about what it's saying. Maps one-to-one onto VRM's preset expressions (happy, sad, angry, surprised, relaxed) plus neutral and thinking (PLAN.md §4.4).",
      "type": "string",
      "enum": [
        "neutral",
        "joy",
        "sad",
        "angry",
        "surprised",
        "relaxed",
        "thinking"
      ]
    },
    "ErrorEvent": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    },
    "EventView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "calendarId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "type": "string",
          "format": "date-time"
        },
        "allDay": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "calendarId",
        "title",
        "location",
        "startsAt",
        "endsAt",
        "allDay"
      ]
    },
    "ExpressionEvent": {
      "type": "object",
      "properties": {
        "emotion": {
          "$ref": "#/$defs/Emotion"
        },
        "intensity": {
          "type": "number"
        }
      },
      "required": [
        "emotion",
        "intensity"
      ]
    },
    "FamiliarState": {
      "type": "string",
      "enum": [
        "idle",
        "thinking",
        "speaking",
        "resting"
      ]
    },
    "FamiliarSummary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "expressiveness": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "expressiveness"
      ]
    },
    "FamiliarView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "userNickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "warmth": {
          "type": "number"
        },
        "playfulness": {
          "type": "number"
        },
        "verbosity": {
          "type": "number"
        },
        "formality": {
          "type": "number"
        },
        "expressiveness": {
          "type": "number"
        },
        "voice": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "voiceSpeed": {
          "type": "number",
          "default": 1
        },
        "proactive": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "appearance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppearanceView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lookUps": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "homePlace": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "userNickname",
        "warmth",
        "playfulness",
        "verbosity",
        "formality",
        "expressiveness"
      ]
    },
    "Gesture": {
      "description": "A one-off body movement the familiar makes mid-sentence.",
      "type": "string",
      "enum": [
        "nod",
        "shake",
        "tilt",
        "wave",
        "shrug",
        "laugh",
        "wink",
        "sigh",
        "yawn",
        "excited"
      ]
    },
    "GestureEvent": {
      "type": "object",
      "properties": {
        "gesture": {
          "$ref": "#/$defs/Gesture"
        }
      },
      "required": [
        "gesture"
      ]
    },
    "HookTokenView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUsedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "lastUsedAt"
      ]
    },
    "InterruptRequest": {
      "type": "object",
      "properties": {
        "replyId": {
          "description": "The reply that was playing when the user interrupted.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "heard": {
          "description": "What of it they heard: the reply is cut to this.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "replyId",
        "heard"
      ]
    },
    "JobKind": {
      "type": "string",
      "enum": [
        "timer",
        "reminder"
      ]
    },
    "JobView": {
      "description": "A pending timer or reminder, as the client shows it.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The job.",
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "description": "Timer or reminder.",
          "$ref": "#/$defs/JobKind"
        },
        "label": {
          "description": "What it's for.",
          "type": "string"
        },
        "dueAt": {
          "description": "When it goes off.",
          "type": "string",
          "format": "date-time"
        },
        "durationSeconds": {
          "description": "For a timer, how long it was set for.",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "description": "When it was set.",
          "type": "string",
          "format": "date-time"
        },
        "ring": {
          "description": "It rings until dismissed (timers, and alarm reminders) rather than notifying.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "dueAt",
        "durationSeconds",
        "createdAt",
        "ring"
      ]
    },
    "JobsEvent": {
      "description": "The account's pending jobs, sent whenever they change, so every device's timer list stays current.",
      "type": "object",
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JobView"
          }
        }
      },
      "required": [
        "jobs"
      ]
    },
    "LlamaColours": {
      "description": "The plush llama's colours, as #rrggbb. Shading is derived from these by the client.",
      "type": "object",
      "properties": {
        "wool": {
          "description": "The fleece.",
          "type": "string"
        },
        "face": {
          "description": "The bare face and snout.",
          "type": "string"
        },
        "ear": {
          "description": "Inside the ears, and the hooves.",
          "type": "string"
        },
        "blush": {
          "description": "The cheeks.",
          "type": "string"
        },
        "accent": {
          "description": "The accessory.",
          "type": "string"
        }
      },
      "required": [
        "wool",
        "face",
        "ear",
        "blush",
        "accent"
      ]
    },
    "LoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "McpServerRequest": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Short and lower-case: it prefixes the tool names the model sees.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The server's streamable-HTTP endpoint.",
          "type": [
