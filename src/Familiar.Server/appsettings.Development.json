{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    // Matches the docker-compose.yml defaults. Local development only, and not a secret.
    "Familiar": "Host=127.0.0.1;Port=5433;Database=familiar;Username=familiar;Password=familiar_dev_only"
  },
  "Auth": {
    // The Vite dev server, which proxies /api here with its own Host: links and sign-in callbacks
    // have to go back to the page, not to this port.
    "PublicUrl": "http://localhost:5273"
  }
}
