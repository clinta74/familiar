# Local development. Copy to .env; docker-compose.yml reads it.

# POSTGRES_PASSWORD must match the connection string in
# src/Familiar.Server/appsettings.Development.json. Postgres reads it only when it initialises an
# empty volume - changing it later needs `docker compose down -v` or an ALTER ROLE.
POSTGRES_DB=familiar
POSTGRES_USER=familiar
POSTGRES_PASSWORD=familiar_dev_only

# Host ports, chosen not to collide with muwbta's dev stack. Published on all interfaces, never
# 127.0.0.1: a loopback-only mapping stalls anything that resolves localhost to ::1 first.
POSTGRES_PORT=5433
ADMINER_PORT=8081
OLLAMA_PORT=11435
STT_PORT=8001
TTS_PORT=8002

# Ollama on CPU. These stop mattering much once docker-compose.gpu.yml is layered on.
OLLAMA_CPUS=4.0
OLLAMA_THREADS=4
OLLAMA_MEMORY=12g
OLLAMA_NUM_PARALLEL=1

# Uncomment to always include the GPU overlay.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
