# NAS deployment. Copy to .env next to docker-compose.nas.yml.

# Required. Read by Postgres only when it initialises an empty data directory.
POSTGRES_PASSWORD=

POSTGRES_DB=familiar
POSTGRES_USER=familiar

# Where things live on the NAS. Models belong on the SSD pool.
FAMILIAR_DATA_DIR=/mnt/tank/familiar
FAMILIAR_BACKUP_DIR=/mnt/tank/familiar/backups
OLLAMA_MODELS_DIR=/mnt/ssd/familiar/ollama

# Images. Pin FAMILIAR_TAG to a release (e.g. 0.1) once there is one; `latest` follows main.
IMAGE_NAMESPACE=candrews74
FAMILIAR_TAG=latest
# Pin these once Phase 0 settles versions, so a pull can't change voice or model behaviour.
OLLAMA_TAG=latest
STT_TAG=latest-cpu
STT_GPU_TAG=latest-cuda
TTS_TAG=latest
TTS_GPU_TAG=latest

# Host port (muwbta has 7180). Postgres isn't published on the NAS; use docker exec for psql.
CLIENT_PORT=7280

# Push for the phone app: ntfy, at the address phones reach it (the ntfy Android app subscribes
# there). e.g. http://nas.lan:2586 or https://ntfy.example.org behind your proxy.
NTFY_BASE_URL=
NTFY_PORT=2586
NTFY_TAG=latest

# Leave false once the admin account exists.
ALLOW_REGISTRATION=false

# Must not overlap muwbta's 172.25.0.0/16 or the VPN's range.
FAMILIAR_SUBNET=172.30.0.0/16

OLLAMA_CPUS=4.0
OLLAMA_THREADS=4
OLLAMA_MEMORY=12g
OLLAMA_NUM_PARALLEL=1

BACKUP_AT_HOUR=3
BACKUP_KEEP=30
