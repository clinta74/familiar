root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,jsonc,css,scss,html,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
indent_size = 4

# Severity here is what the build enforces: Directory.Build.props sets EnforceCodeStyleInBuild and
# warnings are errors, so `warning` means "the build fails". Reserve it for rules the code fully
# satisfies; use `suggestion` for judgement calls.

# --- using directives ---
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- language style ---
# Braces are about correctness, not taste: the unbraced two-line form silently excludes a
# statement added beneath it.
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# --- null handling ---
csharp_style_throw_expression = true:warning
csharp_style_conditional_delegate_call = true:warning

# --- unused code ---
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# --- naming ---
# Advisory: private instance fields are _camelCase. Constants and static readonly fields are
# PascalCase by convention; not enforced, because overlapping naming rules resolve by specificity
# in ways that are easy to get wrong in a build-breaking rule.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true
