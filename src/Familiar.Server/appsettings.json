{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Defaults are in the options classes; these are the keys, so they can be found and overridden
  // (Auth__AllowRegistration=false in compose, and so on).
  "Auth": {
    "CookieName": "familiar.session",
    "SessionDays": 14,
    "RevalidationIntervalSeconds": 60,
    "AllowRegistration": true,
    "LoginFailuresBeforeBackoff": 5,
    "LoginBackoffSeconds": 30,
    "LoginBackoffMaxSeconds": 900,
    "DeviceTokenLifetimeDays": 180,
    "DeviceTokensPerAccount": 10,
    "DeviceTokenTouchMinutes": 60
  },
  // Web Push (PLAN.md §6.2): who runs this server, for push services to contact. mailto: or https:.
  // The VAPID key pair is generated on first use and kept in the database.
  "Push": {
    "Subject": "https://github.com/clinta74/familiar"
  },
  "RateLimits": {
    "AuthAttemptsPerMinute": 10,
    "MessagesPerMinute": 30
  },
  // Familiar's own Ollama (PLAN.md §4.2). Point Model at the derived model, never its base: the
  // base answers with a 4096-token window and silently truncates the prompt.
  "Llm": {
    "BaseUrl": "http://127.0.0.1:11435",
    "Model": "familiar-chat",
    "Temperature": 0.7,
    "RequestTimeoutSeconds": 120,
    "HistoryMessages": 20,
    // Load familiar-chat and the embedding model at startup, and reload them if Ollama restarts.
    "WarmUp": true,
    "WarmUpCheckSeconds": 120
  },
  // 127.0.0.1, not localhost, for every sidecar: on Windows, .NET tries IPv6 ::1 first, the containers
  // only listen on IPv4, and each new connection paid ~2 s waiting for the fallback (measured: 2095 ms
  // vs 4 ms). That alone took a spoken turn from under 2 s to over 4.
  // The speech sidecars (PLAN.md §8). Both are OpenAI-compatible, so either can be swapped.
  "Speech": {
    "SttBaseUrl": "http://127.0.0.1:8001",
    "SttModel": "Systran/faster-distil-whisper-small.en",
    "SttLanguage": "en",
    "TtsBaseUrl": "http://127.0.0.1:8002",
    "TtsModel": "kokoro",
    "DefaultVoice": "af_heart",
    "TtsFormat": "mp3",
    "RequestTimeoutSeconds": 30,
    "WarmUpOnStart": true
  },
  // Off until configured. Set to the compose network on the NAS (see deploy/docker-compose.nas.yml).
  "Proxy": {
    "KnownNetworks": "",
    "KnownProxies": ""
  },
  "Database": {
    "MigrationRetryBudgetSeconds": 60,
    // Each request retries transient database failures (a Postgres restart killing pooled
    // connections, say) this many times, waiting at most this long between attempts.
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 2
  }
}
