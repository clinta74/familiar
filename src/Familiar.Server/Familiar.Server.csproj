<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>familiar-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Familiar.Agent\Familiar.Agent.csproj" />
    <ProjectReference Include="..\Familiar.Domain\Familiar.Domain.csproj" />
    <ProjectReference Include="..\Familiar.Persistence\Familiar.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="ModelContextProtocol.Core" />
